{
  "opencollection": "1.0.0",
  "info": {
    "name": "Archbee Members API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-Api-Key",
      "value": "{{X-Api-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Members",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Archbee List Space Members",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.archbee.com/v1/spaces/:spaceId/members",
            "params": [
              {
                "name": "spaceId",
                "value": "sp_abc123",
                "type": "path",
                "description": "Space identifier"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "X-Api-Key",
              "value": "{{X-Api-Key}}",
              "placement": "header"
            }
          },
          "docs": "List all members with access to a documentation space."
        }
      ]
    }
  ],
  "bundled": true
}