  "info": {
    "_postman_id": "accb792d-5f54-4660-86ed-f959f7bfe169",
    "name": "Archbee Public API",
    "description": "The Archbee Public API manages documentation spaces, documents, space groups, File Manager files, reader suggestions, organization exports and imported OpenAPI references in an Archbee workspace. Authentication uses an HTTP Bearer token whose value is base64(docSpaceId~apiKey), or a team key beginning abteam_.\n\nDerived by API Evangelist from openapi/archbee-public-api-openapi.yml on 2026-09-04. Set the collection variable ARCHBEE_BEARER to base64(docSpaceId~apiKey), or to an organization key beginning abteam_.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
